{
  "version": 1,
  "shared": {
    "background": "#101B26",
    "range": [0, 72],
    "size": {"x": 1920, "y": 1080},
    "audioOffset": 0
  },
  "preview": {
    "fps": 24,
    "resolutionScale": 0.5
  },
  "rendering": {
    "fps": 24,
    "resolutionScale": 1,
    "colorSpace": "srgb",
    "exporter": {
      "name": "@motion-canvas/core/image-sequence",
      "options": {
        "fileType": "image/png",
        "quality": 100,
        "groupByScene": false
      }
    }
  }
}
